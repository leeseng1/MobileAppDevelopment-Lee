  "item": [
    {
      "name": "POST create Running",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));\nconst body = pm.response.json();\npm.collectionVariables.set(\"id\", body.id);\npm.test(\"Location header points at the new workout\", () => {\n    pm.response.to.have.header(\"Location\");\n    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/workouts/\" + body.id);\n});\npm.test(\"Over-posting is ignored\", () => {\n    pm.expect(body.id).to.not.eql(9999);\n    pm.expect(new Date(body.createdAt).getFullYear()).to.be.above(2000);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"id\": 9999,\r\n    \"createdAt\": \"2000-01-01T00:00:00Z\",\r\n    \"currentDate\": \"2030-01-01T07:00:00\",\r\n    \"activityType\": \"Running\",\r\n    \"duration\": 30,\r\n    \"sets\": 0,\r\n    \"reps\": 0,\r\n    \"weight\": 0,\r\n    \"intensityLevel\": \"Medium\",\r\n    \"caloriesBurned\": 300\r\n}",
