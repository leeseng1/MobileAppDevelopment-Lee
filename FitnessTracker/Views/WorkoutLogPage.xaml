<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitnessTracker.Models"
             xmlns:viewmodels="clr-namespace:FitnessTracker.ViewModels"
             xmlns:controls="clr-namespace:FitnessTracker.Views.Controls"
             x:Class="FitnessTracker.Views.WorkoutLogPage"
             x:DataType="viewmodels:WorkoutLogViewModel"
             Title="Workout Log">

    <Grid Padding="16"
          RowDefinitions="2*,3*"
          RowSpacing="12">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="8">
                <Label Text="Record a workout"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Label Text="{Binding CurrentDate, StringFormat='Date: {0:f}'}" 
                       FontSize="15"
                       />

                <Entry Placeholder="Activity (e.g., running)"
                       Text="{Binding ActivityTypeInput}" />

                <Entry Placeholder="Duration in minutes"
                       Keyboard="Numeric"
                       Text="{Binding DurationInput}" />

                <Picker Title="Intensity"
                        ItemsSource="{Binding IntensityLevels}"
                        SelectedItem="{Binding SelectedIntensity}" />

                <Entry Placeholder="Calories burned"
                       Keyboard="Numeric"
                       Text="{Binding CaloriesInput}" />

                <HorizontalStackLayout Spacing="12">
                    <Label Text="Repeat workout"
                           VerticalOptions="Center" />
                    <Switch IsToggled="{Binding IsRecurring}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Picker Title="Repeat frequency"
                        ItemsSource="{Binding Frequencies}"
                        SelectedItem="{Binding SelectedFrequency}"
                        IsVisible="{Binding IsRecurring}"
                        IsEnabled="{Binding IsRecurring}" />
                
                <!-- Reminder Section -->
                <HorizontalStackLayout Spacing="12">
                    <Label Text="Set a reminder"
                            VerticalOptions="Center" />
                    <Switch IsToggled="{Binding HasReminder}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>

                <DatePicker Date="{Binding ReminderDate}"
                            IsEnabled="{Binding HasReminder}" />

                <TimePicker Time="{Binding ReminderTime}"
                            IsEnabled="{Binding HasReminder}" />

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorLabel}" />

                <!-- Swipe Section -->
                <Grid x:Name="SwipeTrack"
                              HeightRequest="48">

                    <Border BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                    </Border>

                    <!-- Green fill grows beneath the thumb as the user drags. -->
                    <Border x:Name="ProgressFill"
                                    Margin="4"
                                    WidthRequest="0"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource GoalProgressGreen}"
                                    Opacity="0"
                                    StrokeThickness="0"
                                    InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                    </Border>
                    
                    <!--label for the swipe instruction with an arrow-->
                    <Label Text="Swipe to save &#8594;"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                TextColor="{StaticResource AppText}"
                                InputTransparent="True" />
                     
                    <!--box for the swipe thumb-->
                    <Grid x:Name="SwipeThumb"
                                  WidthRequest="40"
                                  HeightRequest="40"
                                  Margin="4"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Center">
                        <Border BackgroundColor="{StaticResource AppText}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                        </Border>

                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSwipePanUpdated" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>

                <Label Text="Workout goals"
                       FontSize="18"
                       FontAttributes="Bold" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding WorkoutGoals}"
                        Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:WorkoutGoalCardViewModel">
                            <Border Padding="12" Stroke="{StaticResource AppBorder}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                        </Grid.GestureRecognizers>

                                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Goal.Title}" FontAttributes="Bold" FontSize="18" />
                                            <Label Text="{Binding Goal.Type, StringFormat='Type: {0}'}" />

                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="Current:" />
                                                <Label Text="{Binding Goal.CurrentValue}" />
                                                <Label Text="{Binding Goal.Unit}" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="Target:" />
                                                <Label Text="{Binding Goal.TargetValue}" />
                                                <Label Text="{Binding Goal.Unit}" />
                                            </HorizontalStackLayout>

                                        </VerticalStackLayout>

                                        <controls:GoalProgressRing
                                            Grid.Column="1"
                                            Progress="{Binding Goal.Progress}"
                                            GoalTitle="{Binding Goal.Title}"
                                            IsComplete="{Binding Goal.IsAchieved}"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                 Spacing="6">
                                        <Entry Placeholder="{Binding Goal.Unit, StringFormat='New current value ({0})'}"
                       Keyboard="Numeric"
                       Text="{Binding ProgressInput}" />

                                        <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorLabel}" />

                                        <Button Text="Update progress"
                        Command="{Binding UpdateProgressCommand}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding WorkoutEntries}">
            <Label Text="{Binding Goal.ProgressPercent, StringFormat='Calculated progress: {0:F0}%'}" />
            <CollectionView.EmptyView>
                <Label Text="No workouts loaded yet."
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkoutEntry">
                    <Border Margin="0,5"
                            Padding="14"
                            Stroke="{StaticResource AppBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ActivityType}"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding CurrentDate}"
                                   FontSize="15" />
                            <Label Text="{Binding Duration, StringFormat='Duration: {0} minutes'}" />
                            <Label Text="{Binding IntensityLevel, StringFormat='Intensity: {0}'}" />
                            <Label Text="{Binding CaloriesBurned, StringFormat='Calories: {0}'}" />
                            <Label Text="{Binding IsRecurring, StringFormat='Repeats: {0}'}" />
                            <Label Text="{Binding Frequency, StringFormat='Frequency: {0}'}"
                                   IsVisible="{Binding IsRecurring}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>