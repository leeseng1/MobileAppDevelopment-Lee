<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitnessTracker.Models"
             xmlns:viewmodels="clr-namespace:FitnessTracker.ViewModels"
             x:Class="FitnessTracker.Views.GoalsPage"
             x:DataType="viewmodels:GoalsViewModel"
             Title="Goals">

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="10">
            
            <Label Text="Diet goals"
                   FontSize="20"
                   FontAttributes="Bold" />

            <Border Padding="12"
                Stroke="#D0D0D0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Current diet goals"
                        FontAttributes="Bold" />
                    <Label Text="{Binding DietGoalSummary}" />
                </VerticalStackLayout>
            </Border>

            <Entry Placeholder="Daily calorie target"
                   Keyboard="Numeric"
                   Text="{Binding CaloriesTargetInput}" />

            <Entry Placeholder="Daily protein target (g)"
                   Keyboard="Numeric"
                   Text="{Binding ProteinTargetInput}" />

            <Entry Placeholder="Daily carbs target (g)"
                   Keyboard="Numeric"
                   Text="{Binding CarbsTargetInput}" />

            <Entry Placeholder="Daily fats target (g)"
                   Keyboard="Numeric"
                   Text="{Binding FatsTargetInput}" />

            <Entry Placeholder="Meals per day target"
                   Keyboard="Numeric"
                   Text="{Binding MealsTargetInput}" />

            <Button Text="Save diet goals"
                    Command="{Binding SaveDietGoalCommand}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red" />

            <Label Text="{Binding StatusMessage}"
                   FontAttributes="Bold"
                   FontSize="17"
                   TextColor="Green" />

            <BoxView HeightRequest="1"
                     Color="LightGray"
                     Margin="0,8" />

            <Label Text="Workout goal"
                   FontSize="20"
                   FontAttributes="Bold" />

            <Entry Placeholder="Goal title"
                   Text="{Binding WorkoutGoalTitleInput}" />

            <Picker Title="Goal type"
                    ItemsSource="{Binding GoalTypes}"
                    SelectedItem="{Binding SelectedGoalType}" />

            <Entry Placeholder="Target value"
                   Keyboard="Numeric"
                   Text="{Binding WorkoutTargetInput}" />

            <Entry Placeholder="Current value"
                   Keyboard="Numeric"
                   Text="{Binding WorkoutCurrentInput}" />

            <DatePicker Date="{Binding WorkoutStartDate}" />
            <DatePicker Date="{Binding WorkoutEndDate}" />

            <Button Text="Add workout goal"
                    Command="{Binding SaveWorkoutGoalCommand}" />

            <Label Text="Saved workout goals"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,12,0,0" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding WorkoutGoals}"
                                 Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkoutGoalEntry">
                        <Border Padding="12"
                                Stroke="#D0D0D0">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="18" />
                                <Label Text="{Binding Type, StringFormat='Type: {0}'}" />
                                <Label Text="{Binding CurrentValue, StringFormat='Current: {0}'}" />
                                <Label Text="{Binding TargetValue, StringFormat='Target: {0}'}" />
                                <Label Text="{Binding StartDate, StringFormat='Start: {0:d}'}" />
                                <Label Text="{Binding EndDate, StringFormat='End: {0:d}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>